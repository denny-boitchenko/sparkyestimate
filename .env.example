# SparkyEstimate environment template. Copy to .env and fill in real values.
# NEVER commit a real .env. Placeholders below are examples only.

# --- Database (required) ---
DATABASE_URL=postgresql://localhost:5432/sparkyestimate   # PostgreSQL 16 connection string

# --- AI / Gemini ---
GEMINI_API_KEY=your-gemini-api-key                        # Google Gemini API key (required for AI analysis)
GEMINI_MODEL=gemini-2.5-flash                             # Optional model override; defaults to gemini-2.5-flash

# --- Sessions & encryption ---
SESSION_SECRET=change-me-to-a-long-random-string          # Express session secret (REQUIRED in production)
CREDENTIAL_ENCRYPTION_KEY=                                # Optional; AES key for creds at rest. Falls back to SESSION_SECRET if unset

# --- First-run admin seed ---
ADMIN_USERNAME=admin                                      # First-run admin username (defaults to "admin")
ADMIN_PASSWORD=                                           # First-run admin password (random generated + logged once if unset)

# --- Google Drive OAuth (optional; can also be set in Settings -> Photos) ---
GOOGLE_CLIENT_ID=                                         # Google OAuth client ID
GOOGLE_CLIENT_SECRET=                                     # Google OAuth client secret

# --- Cloudflare R2 photo storage (optional) ---
R2_ACCOUNT_ID=                                            # Cloudflare R2 account ID
R2_ACCESS_KEY_ID=                                         # R2 access key ID
R2_SECRET_ACCESS_KEY=                                     # R2 secret access key
R2_BUCKET_NAME=sparkyestimate-photos                      # R2 bucket name (defaults to sparkyestimate-photos)

# --- Runtime ---
PORT=3000                                                 # HTTP port (defaults to 3000)
NODE_ENV=development                                      # development | production
